<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/maven-v4_0_0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <artifactId>parceler</artifactId>
    <version>1.1.14-SNAPSHOT</version>
    <packaging>jar</packaging>

    <name>Parceler</name>

    <parent>
        <groupId>org.parceler</groupId>
        <artifactId>parceler-project</artifactId>
        <version>1.1.14-SNAPSHOT</version>
        <relativePath>../pom.xml</relativePath>
    </parent>


    <dependencies>
        <dependency>
            <groupId>org.parceler</groupId>
            <artifactId>parceler-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.androidtransfuse</groupId>
            <artifactId>transfuse-bootstrap</artifactId>
            <version>${transfuse.version}</version>
        </dependency>
        <dependency>
            <groupId>com.google.android</groupId>
            <artifactId>android</artifactId>
            <version>${android.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>junit</groupId>
            <artifactId>junit</artifactId>
            <version>${junit.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.mockito</groupId>
            <artifactId>mockito-core</artifactId>
            <version>${mockito.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>org.robolectric</groupId>
            <artifactId>robolectric</artifactId>
            <version>${robolectric.version}</version>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.google.auto.service</groupId>
            <artifactId>auto-service</artifactId>
            <version>${auto-service.version}</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>com.google.auto.service</groupId>
            <artifactId>auto-service-annotations</artifactId>
            <version>${auto-service.version}</version>
            <scope>provided</scope>
        </dependency>
        <!-- Robolectric 4.x resolves androidx.test classes (InstrumentationRegistry) at runtime.
             They ship as aars, so pull them in and unpack classes.jar onto the surefire classpath. -->
        <dependency>
            <groupId>androidx.test</groupId>
            <artifactId>monitor</artifactId>
            <version>${androidx.test.monitor.version}</version>
            <type>aar</type>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>androidx.test</groupId>
            <artifactId>annotation</artifactId>
            <version>${androidx.test.annotation.version}</version>
            <type>aar</type>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>androidx.test.services</groupId>
            <artifactId>storage</artifactId>
            <version>${androidx.test.services.storage.version}</version>
            <type>aar</type>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
        <dependency>
            <groupId>androidx.tracing</groupId>
            <artifactId>tracing</artifactId>
            <version>${androidx.tracing.version}</version>
            <type>aar</type>
            <scope>test</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>${maven-shade-plugin.version}</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <artifactSet>
                                <excludes>
                                    <exclude>org.parceler:parceler-api</exclude>
                                    <exclude>com.google.code.findbugs:jsr305</exclude>
                                </excludes>
                            </artifactSet>
                            <relocations>
                                <relocation>
                                    <pattern>com.google.common</pattern>
                                    <shadedPattern>org.parceler.guava</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.sun.codemodel</pattern>
                                    <shadedPattern>org.parceler.codemodel</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>com.sun_.codemodel</pattern>
                                    <shadedPattern>org.parceler.codemodel</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>javax.inject</pattern>
                                    <shadedPattern>org.parceler.javaxinject</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>javax_.annotation</pattern>
                                    <shadedPattern>org.parceler.javaxannotation</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.androidtransfuse</pattern>
                                    <shadedPattern>org.parceler.transfuse</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.apache</pattern>
                                    <shadedPattern>org.parceler.apache</shadedPattern>
                                </relocation>
                                <relocation>
                                    <pattern>org.aopalliance</pattern>
                                    <shadedPattern>org.parceler.aopalliance</shadedPattern>
                                </relocation>
                            </relocations>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
                <configuration>
                    <annotationProcessors>
                        <annotationProcessor>org.androidtransfuse.bootstrap.BootstrapProcessor</annotationProcessor>
                        <annotationProcessor>com.google.auto.service.processor.AutoServiceProcessor</annotationProcessor>
                    </annotationProcessors>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-source-plugin</artifactId>
                <executions>
                    <execution>
                        <id>attach-sources</id>
                        <goals>
                            <goal>jar</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-javadoc-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>${maven-dependency-plugin.version}</version>
                <executions>
                    <execution>
                        <id>copy-androidx-test-aars</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>copy</goal>
                        </goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>androidx.test</groupId>
                                    <artifactId>monitor</artifactId>
                                    <version>${androidx.test.monitor.version}</version>
                                    <type>aar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.directory}/aars</outputDirectory>
                                    <destFileName>monitor.aar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>androidx.test</groupId>
                                    <artifactId>annotation</artifactId>
                                    <version>${androidx.test.annotation.version}</version>
                                    <type>aar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.directory}/aars</outputDirectory>
                                    <destFileName>annotation.aar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>androidx.test.services</groupId>
                                    <artifactId>storage</artifactId>
                                    <version>${androidx.test.services.storage.version}</version>
                                    <type>aar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.directory}/aars</outputDirectory>
                                    <destFileName>storage.aar</destFileName>
                                </artifactItem>
                                <artifactItem>
                                    <groupId>androidx.tracing</groupId>
                                    <artifactId>tracing</artifactId>
                                    <version>${androidx.tracing.version}</version>
                                    <type>aar</type>
                                    <overWrite>true</overWrite>
                                    <outputDirectory>${project.build.directory}/aars</outputDirectory>
                                    <destFileName>tracing.aar</destFileName>
                                </artifactItem>
                            </artifactItems>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-antrun-plugin</artifactId>
                <version>${maven-antrun-plugin.version}</version>
                <executions>
                    <execution>
                        <id>unpack-androidx-test-aars</id>
                        <phase>process-test-classes</phase>
                        <goals>
                            <goal>run</goal>
                        </goals>
                        <configuration>
                            <target>
                                <mkdir dir="${project.build.directory}/unpacked/androidx-test-monitor"/>
                                <mkdir dir="${project.build.directory}/unpacked/androidx-test-annotation"/>
                                <mkdir dir="${project.build.directory}/unpacked/androidx-test-storage"/>
                                <mkdir dir="${project.build.directory}/unpacked/androidx-tracing"/>
                                <unzip src="${project.build.directory}/aars/monitor.aar" dest="${project.build.directory}/unpacked/androidx-test-monitor">
                                    <patternset>
                                        <include name="classes.jar"/>
                                    </patternset>
                                    <mapper type="flatten"/>
                                </unzip>
                                <unzip src="${project.build.directory}/aars/annotation.aar" dest="${project.build.directory}/unpacked/androidx-test-annotation">
                                    <patternset>
                                        <include name="classes.jar"/>
                                    </patternset>
                                    <mapper type="flatten"/>
                                </unzip>
                                <unzip src="${project.build.directory}/aars/storage.aar" dest="${project.build.directory}/unpacked/androidx-test-storage">
                                    <patternset>
                                        <include name="classes.jar"/>
                                    </patternset>
                                    <mapper type="flatten"/>
                                </unzip>
                                <unzip src="${project.build.directory}/aars/tracing.aar" dest="${project.build.directory}/unpacked/androidx-tracing">
                                    <patternset>
                                        <include name="classes.jar"/>
                                    </patternset>
                                    <mapper type="flatten"/>
                                </unzip>
                            </target>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <version>${maven-surefire-plugin.version}</version>
                <configuration>
                    <additionalClasspathElements>
                        <additionalClasspathElement>${project.build.directory}/unpacked/androidx-test-monitor/classes.jar</additionalClasspathElement>
                        <additionalClasspathElement>${project.build.directory}/unpacked/androidx-test-annotation/classes.jar</additionalClasspathElement>
                        <additionalClasspathElement>${project.build.directory}/unpacked/androidx-test-storage/classes.jar</additionalClasspathElement>
                        <additionalClasspathElement>${project.build.directory}/unpacked/androidx-tracing/classes.jar</additionalClasspathElement>
                    </additionalClasspathElements>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
